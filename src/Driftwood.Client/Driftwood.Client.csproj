<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A normal double-click is a game window, not a game window with a terminal parked behind it.
         Explicit diagnostic modes attach to their parent terminal in ProcessConsole, so the CLI and
         release gate retain their output without making ordinary players watch it. -->
    <OutputType>WinExe</OutputType>
    <RootNamespace>Driftwood.Client</RootNamespace>
    <AssemblyName>Driftwood</AssemblyName>

    <!-- Dresses the file itself: Explorer, shortcuts, the alt-tab list. Deliberately not the whole
         story — the taskbar button of a running window belongs to the window, and GLFW creates one
         without an icon, so ClientHost sets that separately from the embedded PNGs below. -->
    <ApplicationIcon>..\..\assets\driftwood.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Carried inside the assembly rather than shipped beside it, so the artifact stays an exe with
       no art folder to lose. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\window-icon-32.png" LogicalName="Driftwood.Client.window-icon-32.png" />
    <EmbeddedResource Include="..\..\assets\window-icon-64.png" LogicalName="Driftwood.Client.window-icon-64.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.14" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.14" />
    <PackageReference Include="SDL3-CS.Linux" Version="3.4.14" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
    <PackageReference Include="Silk.NET.GLFW" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Maths" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Extensions.Creative" Version="2.23.0" />
    <PackageReference Include="Silk.NET.OpenAL.Soft.Native" Version="1.23.1" />
    <PackageReference Include="Silk.NET.OpenGL" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Driftwood.Core\Driftwood.Core.csproj" />
  </ItemGroup>

  <!-- N6: the optional Epic module (co-op meeting place). Built and copied beside the game only when
       Epic's SDK is unpacked at EosSdkRoot (default: EOS/SDK beside the repo folder) — the SDK is
       Epic's and never in this repository. The game loads the module by reflection, so a build
       without it plays direct-address co-op unchanged. WithEos=false leaves it out on purpose. -->
  <PropertyGroup>
    <EosSdkRoot Condition="'$(EosSdkRoot)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../../EOS/SDK'))</EosSdkRoot>
    <WithEos Condition="'$(WithEos)' == '' and Exists('$(EosSdkRoot)/Source/Core')">true</WithEos>
    <EosNative Condition="'$(RuntimeIdentifier)' != '' and $(RuntimeIdentifier.StartsWith('win'))">EOSSDK-Win64-Shipping.dll</EosNative>
    <EosNative Condition="'$(EosNative)' == '' and '$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">EOSSDK-Win64-Shipping.dll</EosNative>
    <EosNative Condition="'$(EosNative)' == ''">libEOSSDK-Linux-Shipping.so</EosNative>
    <EosPlatformName Condition="'$(EosNative)' == 'EOSSDK-Win64-Shipping.dll'">Windows64</EosPlatformName>
    <EosPlatformName Condition="'$(EosPlatformName)' == ''">Linux</EosPlatformName>
  </PropertyGroup>

  <ItemGroup Condition="'$(WithEos)' == 'true'">
    <ProjectReference Include="..\Driftwood.Net.Eos\Driftwood.Net.Eos.csproj" ReferenceOutputAssembly="false"
                      OutputItemType="Content" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest"
                      ExcludeFromSingleFile="true" SetRuntimeIdentifier="false" GlobalPropertiesToRemove="SelfContained;PublishSingleFile"
                      AdditionalProperties="EosSdkRoot=$(EosSdkRoot);EosPlatform=$(EosPlatformName)" />
    <None Include="$(EosSdkRoot)/Bin/$(EosNative)" Link="$(EosNative)" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <!-- The game's credentials (gitignored, the user's): the program reads them from beside itself. -->
    <None Include="..\..\eos.txt" Condition="Exists('..\..\eos.txt')" Link="eos.txt" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
