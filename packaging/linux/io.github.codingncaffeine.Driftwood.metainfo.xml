<component type="desktop-application">
  <id>io.github.codingncaffeine.Driftwood</id>
  <name>Driftwood</name>
  <summary>Open-world survival crafting game</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.codingncaffeine">
    <name>codingncaffeine</name>
  </developer>
  <description>
    <p>
      Start with empty hands, gather materials, make tools and workstations, build, explore,
      fight, trade, learn magic, command companions, and return to the same persistent
      procedurally generated world later.
    </p>
    <ul>
      <li>Seeded worlds with biomes, caves, ruins, settlements, weather, and flowing water and lava</li>
      <li>Destructible terrain, building, crafting, smelting, farming, rails and signals</li>
      <li>Classless progression to level 20, nineteen spells and four commanded companions</li>
      <li>Keyboard, mouse and controller play, with every control rebindable</li>
      <li>Texture packs, sound packs and player skins</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.codingncaffeine.Driftwood.desktop</launchable>
